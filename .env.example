# ==============================================================================
# ALPACA AI OPTIONS TRADING DESK — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ─── 1. ALPACA TRADING API CREDENTIALS ────────────────────────────────────────
# Get your keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_URL=https://data.alpaca.markets/v2

# ─── 2. PRIMARY LLM: FEATHERLESS DEEPSEEK-V3.2 ───────────────────────────────
# Get API key at https://featherless.ai
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_MODEL=deepseek-ai/DeepSeek-V3.2
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
TEMPERATURE=0.1
MAX_TOKENS=1000

# ─── 3. SECONDARY / FAILOVER LLM: GROQ API ───────────────────────────────────
# Get API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ─── 4. POSTGRESQL / SUPABASE DATABASE ───────────────────────────────────────
# e.g., postgresql://postgres:password@db.host.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/alpaca_trading
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-key

# ─── 5. GMAIL SMTP TELEMETRY & CYCLE ALERTS ───────────────────────────────────
# Use a 16-character Google App Password (not your personal password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_LOGIN=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
ALERT_EMAIL=recipient_email@gmail.com

# ─── 6. SERVER / CLOUD CONFIGURATION ─────────────────────────────────────────
PORT=8000
ENVIRONMENT=production
